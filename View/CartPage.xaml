<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PawsitivePlace.View.CartPage"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Your Cart" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

        <CollectionView ItemsSource="{Binding CartItems}" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10" Spacing="10" BackgroundColor="#F0F0F0" Margin="0,5">
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="{Binding ImageSource}" Aspect="AspectFit" WidthRequest="80" HeightRequest="80"/>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding AnimalName, StringFormat='Animal: {0}'}" FontAttributes="Bold"/>
                                <Label Text="{Binding AnimalType, StringFormat='Type: {0}'}"/>
                                <Label Text="{Binding AddedAt, StringFormat='Added: {0:g}'}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Button Text="Remove from Cart" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveItemCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="#FF6B6B" 
                                TextColor="White"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Spacing="10" VerticalOptions="EndAndExpand">
            <Label Text="{Binding CartItems.Count, StringFormat='Total Items: {0}'}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>

            <Button Text="Checkout" 
                    Command="{Binding CheckoutCommand}" 
                    BackgroundColor="#4CAF50" 
                    TextColor="White"
                    Padding="15"/>

            <Button Text="Back to Results" 
                    Command="{Binding BackCommand}" 
                    BackgroundColor="#2196F3" 
                    TextColor="White"
                    Padding="15"/>
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
