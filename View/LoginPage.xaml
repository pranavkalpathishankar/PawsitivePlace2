<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PawsitivePlace.View.LoginPage"
             Title="{Binding Title}">
    <VerticalStackLayout>
        <Label Text="{Binding UserNameString}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        
        <Entry WidthRequest="300"
               Placeholder="{Binding UserNameString}" />

        <Label Text="{Binding PasswordString}"
               VerticalOptions="Center" 
               HorizontalOptions="Center" />

        <Entry WidthRequest="300"
               Placeholder="{Binding PasswordString}" />

        <ImageButton
            Source="loginbutton.jpg"
            BackgroundColor="White"
            Aspect="AspectFit"
            BorderWidth="2" />
    </VerticalStackLayout>
</ContentPage>