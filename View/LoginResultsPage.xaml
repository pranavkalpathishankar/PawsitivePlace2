<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PawsitivePlace.View.LoginResultsPage"
             Title= "{Binding Title}">
    <ScrollView>
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
              ColumnDefinitions="*, *"
              RowSpacing="30"
              ColumnSpacing="10"
              Padding="15">

            <Button Grid.Row="0" Grid.Column="0" 
                    ImageSource="americancurl.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="cat" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>

            <Button Grid.Row="0" Grid.Column="1" 
                    ImageSource="britishshorthair.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="cat" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>

            <Button Grid.Row="1" Grid.Column="0" 
                    ImageSource="burmese.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="cat" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>

            <Button Grid.Row="1" Grid.Column="1" 
                    ImageSource="finch.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="bird" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>
            
            <Button Grid.Row="2" Grid.Column="0" 
                    ImageSource="german_shepherd.png" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="dog" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>

            <Button Grid.Row="2" Grid.Column="1" 
                    ImageSource="golden_retriever.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="dog" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>

            <Button Grid.Row="3" Grid.Column="0" 
                    ImageSource="parakeet.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="bird" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>
            
            <Button Grid.Row="3" Grid.Column="1" 
                    ImageSource="rottweiler.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="dog" 
                    BackgroundColor="Transparent" 
                    Padding="0"/>

            <Button Grid.Row="4" Grid.Column="0" 
                    ImageSource="scarletmacaw.jpg" 
                    Command="{Binding AdoptCommand}" 
                    CommandParameter="bird"
                    BackgroundColor="Transparent" 
                    Padding="0"/>

        </Grid>
    </ScrollView>

</ContentPage>