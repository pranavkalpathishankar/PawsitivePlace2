<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PawsitivePlace.View.LoginResultsPage"
             Title="{Binding Title}">
    <VerticalStackLayout Spacing="10">

        <!-- Filter Buttons -->
        <HorizontalStackLayout Padding="15,10" Spacing="8" HorizontalOptions="CenterAndExpand">
            <Button Text="All" 
                    Command="{Binding FilterByCategoryCommand}" 
                    CommandParameter="All"
                    BackgroundColor="#F4A460"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="12,8"
                    FontSize="12"/>

            <Button Text="🐱 Cats" 
                    Command="{Binding FilterByCategoryCommand}" 
                    CommandParameter="cat"
                    BackgroundColor="#2E7D9E"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="12,8"
                    FontSize="12"/>

            <Button Text="🐕 Dogs" 
                    Command="{Binding FilterByCategoryCommand}" 
                    CommandParameter="dog"
                    BackgroundColor="#FF9844"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="12,8"
                    FontSize="12"/>

            <Button Text="🐦 Birds" 
                    Command="{Binding FilterByCategoryCommand}" 
                    CommandParameter="bird"
                    BackgroundColor="#4FA3C6"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="12,8"
                    FontSize="12"/>
        </HorizontalStackLayout>

        <!-- Selected Filter Display -->
        <Label Text="{Binding SelectedFilter, StringFormat='Filter: {0}'}"
               HorizontalOptions="Center"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#2C2520"
               Margin="0,5,0,10"/>

        <!-- Animals Grid using CollectionView -->
        <CollectionView ItemsSource="{Binding FilteredAnimalsGrid}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" HorizontalItemSpacing="10" VerticalItemSpacing="20" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="10" Padding="5" WidthRequest="150">
                        <Image Source="{Binding imageFile}" Aspect="AspectFit" HeightRequest="150" WidthRequest="150"/>
                        <Button ImageSource="adoptbutton.jpg" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AdoptCommand}" 
                                CommandParameter="{Binding animalKey}"
                                BackgroundColor="Transparent" 
                                BorderWidth="0" 
                                Padding="0" 
                                WidthRequest="150" 
                                HeightRequest="60"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>