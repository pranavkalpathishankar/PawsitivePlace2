<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PawsitivePlace.View.RegisterPage"
             Title="{Binding Title}">
    <VerticalStackLayout>
        <Label Text="{Binding UserNameText}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry WidthRequest="300"
               Placeholder="{Binding UserNameText}" />

        <Label Text="{Binding PasswordText}"
               VerticalOptions="Center" 
               HorizontalOptions="Center" />

        <Entry WidthRequest="300"
               Placeholder="{Binding PasswordText}" />

        <Label Text="{Binding PasswordConfirm}"
               VerticalOptions="Center" 
               HorizontalOptions="Center" />

        <Entry WidthRequest="300"
               Placeholder="{Binding PasswordConfirm}" />

        <ImageButton
            Source="registerbutton.jpg"
            Command="{Binding LoginButtonClickedCommand}"
            BackgroundColor="Transparent"
            Aspect="AspectFit"
            BorderWidth="2" />
    </VerticalStackLayout>
</ContentPage>