<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PawsitivePlace.View.RegisterPage"
             Title="{Binding Title}">
    <VerticalStackLayout>

        <Entry x:Name="EntryUserName"
               PlaceholderColor="Blue"
               Placeholder="Username"
               Text="{Binding UserNameText, Mode=TwoWay}"
               WidthRequest="300" />

        <Entry x:Name="EntryPassword"
               PlaceholderColor="Blue"
               Placeholder="Password"
               Text="{Binding PasswordText, Mode=TwoWay}"
               IsPassword="True"
               TextColor="IndianRed"   
               WidthRequest="300" />

        <Entry x:Name="EntryConfirmPassword"
               PlaceholderColor="Blue"
               Placeholder="Confirm Password"
               Text="{Binding PasswordConfirm, Mode=TwoWay}"
               IsPassword="True"
               TextColor="IndianRed"   
               WidthRequest="300" />

        <Button
            ImageSource="{Binding RegisterButton}"
            Command="{Binding RegisterCommand}"
            BackgroundColor="Transparent"
            BorderWidth="2" />
        
    </VerticalStackLayout>
</ContentPage>